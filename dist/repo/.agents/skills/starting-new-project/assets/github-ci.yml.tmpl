name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  verify:
    name: Verify
    runs-on: {{CI_RUNNER}}       # e.g. ubuntu-latest, ubuntu-22.04
    timeout-minutes: 15

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up {{LANGUAGE_RUNTIME_LABEL}}
        # Replace this step with the appropriate setup action for your language:
        # Node.js:  uses: actions/setup-node@v4  with: { node-version: '20' }
        # Python:   uses: actions/setup-python@v5  with: { python-version: '3.12' }
        # Go:       uses: actions/setup-go@v5  with: { go-version: '1.23' }
        # Java:     uses: actions/setup-java@v4  with: { java-version: '21', distribution: 'temurin' }
        uses: {{SETUP_ACTION}}
        with:
          {{SETUP_ACTION_ARGS}}

      - name: Install dependencies
        run: {{INSTALL_COMMAND}}

      - name: Verify
        run: {{VERIFY_COMMANDS}}
        # This must be identical to the verify command in AGENTS.md.
        # If they differ, AGENTS.md needs updating.

  # Optional: add separate jobs for build, lint, type-check if you want
  # granular CI feedback rather than one combined step.
