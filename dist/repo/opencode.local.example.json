{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/local-model",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "local-model": {
          "name": "Local model"
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "skill": {
      "*": "ask"
    },
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
